
# Required. A Claude API key; the model is claude-sonnet-5-5 on the Claude API
# directly (not Bedrock, Vertex or Foundry).
ANTHROPIC_API_KEY=
# Optional, chat only. A file that records every message, model response and
# tool result as JSON lines, for debugging. It is overwritten at each start
# and holds confirmation tokens and user data.
SOFRA_TRACE=trace.jsonl